# Copiar a backend/.env (se lee solo si uvicorn corre desde backend/).
ENVIRONMENT=local

# ── Admin de datos (/api/admin) ──────────────────────────────────────────────
# APAGADO POR DEFECTO: sin ENABLE_ADMIN=true el router no se registra (404) y el
# tablero público funciona igual. Si se enciende y falta algo de lo siguiente
# (o es inseguro), el admin NO se registra y el log dice el motivo.
# ENABLE_ADMIN=true
# ADMIN_USER=analista
# Hash scrypt de la contraseña (no la contraseña). Generarlo desde backend/:
#   python -m app.tools.hash_password
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...$...
# Mínimo 32 caracteres y no un valor de ejemplo. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Modo de sesión (sin la variable, el código usa http://localhost:5173,http://127.0.0.1:5173,
# que es lo que necesita el desarrollo local con Vite en :5173 y la API en :8000):
#  - vacío  -> mismo dominio (frontend y API bajo el mismo host): cookie SameSite=Strict.
#  - valor  -> dominios distintos: CORS con credenciales solo para estos orígenes exactos,
#              cookie SameSite=None; Secure y token CSRF obligatorio. Nunca '*'.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mismo dominio (servidor propio con proxy): dejarla definida y vacía
# CORS_ORIGINS=

# Almacén del admin: parquet/ (publicados), staging/, backup/ y admin_log.jsonl.
# Por defecto backend/storage. En un volumen, al arrancar se siembran desde el repo
# solo los Parquet que falten (nunca se sobrescriben los publicados).
# DATA_STORE_DIR=/data
# true si DATA_STORE_DIR es un disco persistente dentro de la app (fuera de backend/ ya cuenta como persistente)
# DATA_STORE_PERSISTENT=false
# Tamaño máximo por archivo subido
# MAX_UPLOAD_MB=100

# Límite de intentos de login por IP: tomar la IP de X-Forwarded-For solo detrás de proxy de confianza.
# TRUST_PROXY=false
# Número de proxies de confianza delante del backend (Railway: 1)
# TRUSTED_PROXY_HOPS=1

# Compatibilidad (legado): si se define, es la carpeta de publicados en lugar de <DATA_STORE_DIR>/parquet
# PARQUET_DIR=/opt/render/project/src/backend/storage/parquet
